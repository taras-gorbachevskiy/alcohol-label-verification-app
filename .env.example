# Copy to .env for local use: cp .env.example .env
# Never commit .env — it is gitignored.
# On Railway, set these in the service Variables UI instead.

# Deploy convention only — not read by app code yet.
APP_ENV=development

# Local default. Railway injects PORT at runtime; do not hardcode in production.
PORT=8000

# VisionService (Phase 2) — required for live extraction / scripts/extract_sample.py
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
