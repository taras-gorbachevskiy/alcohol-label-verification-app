# Copy to .env for local use: cp .env.example .env
# Never commit .env — it is gitignored.
# On Railway, set these in the service Variables UI instead.

# Deploy convention only — not read by app code yet.
APP_ENV=development

# Local default. Railway injects PORT at runtime; do not hardcode in production.
PORT=8000

# VisionService (Phase 2) — required for live extraction / scripts/extract_sample.py
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14

# Always-on, per-process abuse controls for POST /verify and /verify/batch.
VERIFY_RATE_LIMIT_PER_MINUTE=5
VERIFY_RATE_LIMIT_PER_HOUR=30
VERIFY_GLOBAL_RATE_LIMIT_PER_HOUR=100
VERIFY_MAX_CONCURRENT=5
